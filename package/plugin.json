{
  "name": "google-workspace",
  "version": "1.4.0",
  "description": "Mail, Calendar and Drive in Buwiz Bot, with the Google account you sign in to.",
  "author": { "name": "Buwiz" },
  "homepage": "https://github.com/buwiz-app/google-workspace",
  "mcpServers": {
    "gws": {
      "command": "${PLUGIN_ROOT}/bin/buwiz-gws",
      "args": ["mcp"],
      "env": { "BUWIZ_PLUGIN_MANIFEST": "${PLUGIN_ROOT}/manifest.signed.json" }
    }
  },
  "buwiz": {
    "protocol": "1.0.0",
    "id": "app.buwiz.google-workspace",
    "short": "gws",
    "version": "1.4.0",
    "server": "gws",
    "accounts": [
      {
        "id": "google",
        "provider": "google",
        "label": "Google account",
        "scopes": ["https://www.googleapis.com/auth/gmail.modify"],
        "required": true
      }
    ],
    "files": {},
    "binaries": {},
    "publisher": { "id": "app.buwiz", "key_id": "gc-2026-01" }
  }
}
